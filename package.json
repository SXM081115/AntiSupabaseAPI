{
  "name": "antisupabase-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker reverse proxy for Supabase Edge API (/functions/v1, /auth/v1, /storage/v1) with server-side key injection.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "mock:upstream": "node scripts/mock-upstream.mjs",
    "tail": "wrangler tail --format pretty",
    "secret:service": "wrangler secret put SUPABASE_SERVICE_ROLE_KEY",
    "secret:anon": "wrangler secret put SUPABASE_ANON_KEY",
    "secret:token": "wrangler secret put PROXY_TOKEN"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
