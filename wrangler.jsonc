{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antisupabase-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // ===== 自定义域名接入：默认「只开 workers.dev」，保证首次 deploy 必定成功 =====
  // 选定方案后取消对应注释即可；同一主机名不能同时是两台 Worker 的 Custom Domain，
  // 但可以「A 持有 Custom Domain + B 持有更具体的路径路由」，Cloudflare 优先匹配更具体的路径。
  //
  // 方案 A（推荐，edge.sxm2027.icu 已被另一个 Worker 占用时用这个）：
  //   保持原来那个 Worker 与 Custom Domain 完全不动，只给本 Worker 加一条路径路由。
  //   注意：放开前先确认 sxm2027.icu 这个 zone 在同一个 Cloudflare 账号里，否则 deploy 会因找不到 zone 而整体失败。
  //   同时必须把下面的 PROXY_PREFIX 改成 "/sb"（与路由路径对齐）。
  //   客户端访问：https://edge.sxm2027.icu/sb/functions/v1/<函数名>
  // "routes": [
  //   { "pattern": "edge.sxm2027.icu/sb/*", "zone_name": "sxm2027.icu" }
  // ],
  //
  // 方案 B（另起一个没人用的子域，Cloudflare 自动建 DNS 记录与证书，零冲突）：
  //   客户端访问：https://edge-api.sxm2027.icu/functions/v1/<函数名>
  // "routes": [
  //   { "pattern": "edge-api.sxm2027.icu", "custom_domain": true }
  // ],
  //
  // 方案 C（什么都不配）：
  //   客户端访问：https://antisupabase-api.<你的子域>.workers.dev/functions/v1/<函数名>

  // 实测 edge.sxm2027.icu 当前无任何生效记录（TLS 握手中断，表现与随机子域一致），
  // 因此先直接按 Custom Domain 绑定；若该主机名确实被别的 Worker 占用，deploy 会报错，
  // 届时改用上面的「方案 A」路径路由即可共存。
  "routes": [
    { "pattern": "edge.sxm2027.icu", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    // ===== 目标：两种写法二选一 =====
    // 1) 只给 project ref，Worker 会拼成 https://<ref>.supabase.co
    //    已填真实值：bkewnttfjkbbshnouwtv → https://bkewnttfjkbbshnouwtv.supabase.co（已实测连通，未带 key 返回 401）
    "SUPABASE_PROJECT_REF": "bkewnttfjkbbshnouwtv",
    // 2) 若你用的是 Supabase 自定义域名，填完整 URL（优先于上面的 ref）
    // "SUPABASE_BASE_URL": "https://api.your-domain.com",

    // ===== 路由 =====
    // 走 wrangler.jsonc 里的「方案 A」路径路由时，这里必须改成 "/sb"；其余方案保持 ""
    "PROXY_PREFIX": "",
    "ALLOWED_PATH_PREFIXES": "/functions/v1/,/auth/v1/,/storage/v1/",

    // 哪些路径用 service_role key、哪些用 anon key（按前缀最长者优先匹配）
    "SERVICE_KEY_PREFIXES": "/functions/v1/,/auth/v1/admin/",
    "ANON_KEY_PREFIXES": "/auth/v1/,/storage/v1/",
    "DEFAULT_KEY_SLOT": "anon",

    // ===== CORS：填 * 表示放行所有来源（你的要求：所有用户都能访问）=====
    // 用 * 时浏览器不允许携带凭据，本项目已强制把 Access-Control-Allow-Credentials 关掉
    "ALLOWED_ORIGINS": "*",
    "CORS_ALLOW_HEADERS": "authorization,apikey,content-type,x-client-info,x-request-id,x-supabase-api-version,x-upsert,x-proxy-token,prefer,range,accept,accept-language,cache-control,if-none-match",
    "CORS_ALLOW_METHODS": "GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS",
    "CORS_EXPOSE_HEADERS": "x-request-id,x-proxy-cache,content-range,content-length,location,link,x-supabase-api-version",
    "CORS_MAX_AGE": "86400",
    "CORS_ALLOW_CREDENTIALS": "false",

    // ===== 上游弹性：超时 / 重试 / 熔断 =====
    "UPSTREAM_TIMEOUT_MS": "30000",
    "MAX_RETRIES": "1",
    "RETRY_BACKOFF_MS": "250",
    "MAX_TOTAL_MS": "60000",
    "RETRY_STATUSES": "502,503,504",
    "RETRY_ON_429": "false",
    "RETRY_AFTER_MAX_MS": "5000",
    "CIRCUIT_FAIL_THRESHOLD": "5",
    "CIRCUIT_OPEN_MS": "15000",

    // ===== 缓存（仅 GET，且只对下面这些前缀生效）=====
    "CACHE_ENABLED": "true",
    "CACHE_TTL_SECONDS": "60",
    "CACHE_PATH_PREFIXES": "/storage/v1/object/public/",
    "CACHE_VARY_HEADERS": "accept,accept-language",

    // ===== URL / Cookie 改写 =====
    "REWRITE_LOCATION": "true",
    "REWRITE_JSON_HOSTS": "false",
    "COOKIE_DOMAIN_STRIP": "true",
    "STRIP_CLIENT_COOKIES": "true",

    // ===== 入口门槛：默认完全开放；把它改成 "true" 并 set 一个 PROXY_TOKEN 即启用共享令牌 =====
    "ENFORCE_PROXY_TOKEN": "false",

    // ===== 可观测 =====
    "LOG_LEVEL": "info",
    "DEBUG_UPSTREAM_ERRORS": "false"
  }
}
